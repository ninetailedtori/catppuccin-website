---
import { githubUrl } from "@data/links";

import Default from "@layouts/Default.astro";

import PageIntro from "@components/PageIntro.astro";

import FlavorName from "./_components/FlavorName.svelte";

import PaletteSwatches from "./_components/PaletteSwatches.svelte";
import PaletteIngredients from "./_components/PaletteIngredients.svelte";
---

<script>
  function syncTabState() {
    const currentHash = window.location.hash.slice(1) || "tabber-Swatches";
    document.querySelectorAll(".tabber__tab").forEach((btn) => {
      const isActive = btn.getAttribute("aria-controls") === currentHash;
      btn.setAttribute("aria-selected", isActive ? "true" : "false");
    });
  }

  syncTabState();

  window.addEventListener("hashchange", syncTabState);
  document.querySelectorAll(".tabber__tab").forEach((button) => {
    button.addEventListener("click", () => {
      const tabId = button.getAttribute("aria-controls");
      if (!tabId) return;
      window.location.hash = tabId;
    });
  });
</script>

<Default
  title="Palette • Catppuccin"
  description="Dive into Catppuccin's palette: four unique pastel color palettes named 'flavors'. Ideal for your next project!">
  <PageIntro title="Palette">
    <p>
      Catppuccin consists of 4 beautiful pastel color palettes, named <strong>flavors</strong>. The theme comes in one
      light and three dark variants:
    </p>
    <ul>
      <li>
        <FlavorName flavor="latte" />: Our lightest theme harmoniously inverting the essence of Catppuccin's dark
        themes.
      </li>
      <li>
        <FlavorName flavor="frappe" />: A less vibrant alternative using subdued colors for a muted aesthetic.
      </li>
      <li>
        <FlavorName flavor="macchiato" />: Medium contrast with gentle colors creating a soothing atmosphere.
      </li>
      <li>
        <FlavorName flavor="mocha" />: The Original — Our darkest variant offering a cozy feeling with color-rich
        accents.
      </li>
    </ul>
    <p>
      If you'd like to use them for your own project, refer to our
      <a href=`${githubUrl}/catppuccin/blob/main/docs/style-guide.md`>style guide</a>
      for general use cases and guidelines. Additionally, you can find integrations with popular frameworks and tools in
      <a href=`${githubUrl}/palette`>catppuccin/palette</a>.
    </p>
  </PageIntro>

  <div class="tabber tabber--init">
    <header class="tabber__header">
      <nav class="tabber__tabs" role="tablist">
        <button
          class="tabber__tab"
          role="tab"
          id="tabber-Swatches-label"
          aria-controls="tabber-Swatches"
          aria-selected="true">
          Swatches
        </button>
        <button
          class="tabber__tab"
          role="tab"
          id="tabber-Ingredients-label"
          aria-controls="tabber-Ingredients"
          aria-selected="false">
          Ingredients
        </button>
      </nav>
    </header>
    <section class="tabber__section">
      <article
        class="tabber__panel"
        role="tabpanel"
        tabindex="0"
        id="tabber-Swatches"
        aria-labelledby="tabber-Swatches-label">
        <PaletteSwatches client:load />
      </article>
      <article
        class="tabber__panel"
        role="tabpanel"
        tabindex="0"
        id="tabber-Ingredients"
        aria-labelledby="tabber-Ingredients-label">
        <PaletteIngredients client:load />
      </article>
    </section>
  </div>
</Default>

<style>
  .tabber__header {
    margin-bottom: 2rem;
  }

  .tabber__tabs {
    display: flex;
    gap: 0.5rem;
    background-color: var(--mantle);
    padding: 0.5rem;
    border-radius: 15px;
    width: fit-content;
  }

  .tabber__tab {
    padding: 0.625rem 1.5rem;
    color: var(--text);
    background-color: transparent;
    border: none;
    cursor: pointer;
    border-radius: 10px;
    transition: all 200ms ease;
    font: inherit;

    &:hover {
      background-color: var(--surface0);
      color: var(--mauve);
    }

    &:focus,
    &:focus-visible {
      background-color: var(--mauve);
      color: var(--base);
      outline: none;
    }

    &[aria-selected="true"] {
      background-color: var(--mauve);
      color: var(--base);
    }
  }

  .tabber__section {
    display: grid;
    overflow: hidden;
    block-size: 100%;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    scroll-snap-type: x mandatory;
  }

  .tabber__panel {
    height: max-content;
    overflow-x: auto;
    scroll-snap-align: start;
  }
</style>
