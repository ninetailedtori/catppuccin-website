---
import { githubUrl } from "@data/links";

import Default from "@layouts/Default.astro";

import PageIntro from "@components/PageIntro.astro";

import FlavorName from "./_components/FlavorName.svelte";

import PaletteSwatches from "./_components/PaletteSwatches.svelte";
import PaletteIngredients from "./_components/PaletteIngredients.svelte";
---

<script>
  function syncTabState() {
    const isIngredients = window.location.hash.slice(1) === "ingredients";
    document.querySelectorAll(".tabber__tab").forEach((btn) => {
      const tabId = btn.getAttribute("aria-controls");
      const isActive = isIngredients ? tabId === "ingredients" : tabId === "swatches";
      btn.setAttribute("aria-selected", isActive ? "true" : "false");
    });
    updatePillPosition();
  }

  function getActivePanel() {
    const isIngredients = window.location.hash.slice(1) === "ingredients";
    const panelId = isIngredients ? "ingredients" : "swatches";
    return document.getElementById(panelId) as HTMLElement | null;
  }

  function updateHeight() {
    const section = document.querySelector(".tabber__section") as HTMLElement | null;
    const activePanel = getActivePanel();
    if (!section || !activePanel) return;
    const innerContent = activePanel.querySelector("section") as HTMLElement | null;
    // FIXME: Added the 40px buffer because the resize is cut off at the bottom. Can't work out why it's cut off, so
    // let's replace it with a smarter solution eventually.
    const height = (innerContent?.scrollHeight || activePanel.scrollHeight) + 40;
    section.style.height = height + "px";
  }

  function updatePillPosition() {
    const activeTab = document.querySelector(".tabber__tab[aria-selected='true']") as HTMLElement | null;
    const nav = document.querySelector(".tabber__tabs") as HTMLElement | null;
    const pill = document.querySelector(".tabber__pills-background") as HTMLElement | null;

    if (!activeTab || !nav || !pill) return;

    const navStyles = window.getComputedStyle(nav);
    const paddingLeft = parseFloat(navStyles.paddingLeft);

    const offsetLeft = activeTab.offsetLeft - paddingLeft;
    const width = activeTab.offsetWidth;

    pill.style.transform = `translateX(${offsetLeft}px)`;
    pill.style.width = `${width}px`;
  }

  syncTabState();
  window.addEventListener("hashchange", () => {
    syncTabState();
    updateHeight();
  });
  document.querySelectorAll(".tabber__tab").forEach((button) => {
    button.addEventListener("click", () => {
      const tabId = button.getAttribute("aria-controls");
      if (!tabId) return;
      window.location.hash = tabId;
    });
  });
  window.addEventListener("resize", updatePillPosition);
  setTimeout(() => {
    updateHeight();
    document.querySelectorAll("details").forEach((details) => {
      details.addEventListener("toggle", () => {
        updateHeight();
        setTimeout(updateHeight, 350);
      });
    });
  }, 100);
</script>

<Default
  title="Palette • Catppuccin"
  description="Dive into Catppuccin's palette: four unique pastel color palettes named 'flavors'. Ideal for your next project!">
  <PageIntro title="Palette">
    <p>
      Catppuccin consists of 4 beautiful pastel color palettes, named <strong>flavors</strong>. The theme comes in one
      light and three dark variants:
    </p>
    <ul>
      <li>
        <FlavorName flavor="latte" />: Our lightest theme harmoniously inverting the essence of Catppuccin's dark
        themes.
      </li>
      <li>
        <FlavorName flavor="frappe" />: A less vibrant alternative using subdued colors for a muted aesthetic.
      </li>
      <li>
        <FlavorName flavor="macchiato" />: Medium contrast with gentle colors creating a soothing atmosphere.
      </li>
      <li>
        <FlavorName flavor="mocha" />: The Original — Our darkest variant offering a cozy feeling with color-rich
        accents.
      </li>
    </ul>
    <p>
      If you'd like to use them for your own project, refer to our
      <a href=`${githubUrl}/catppuccin/blob/main/docs/style-guide.md`>style guide</a>
      for general use cases and guidelines. Additionally, you can find integrations with popular frameworks and tools in
      <a href=`${githubUrl}/palette`>catppuccin/palette</a>.
    </p>
  </PageIntro>

  <div class="tabber tabber--init">
    <header class="tabber__header">
      <nav class="tabber__tabs" role="tablist">
        <div class="tabber__pills-background"></div>
        <button class="tabber__tab" role="tab" id="tabber-swatches-label" aria-controls="swatches" aria-selected="true">
          Swatches
        </button>
        <button
          class="tabber__tab"
          role="tab"
          id="tabber-ingredients-label"
          aria-controls="ingredients"
          aria-selected="false">
          Ingredients
        </button>
      </nav>
    </header>
    <section class="tabber__section">
      <article class="tabber__panel" role="tabpanel" tabindex="0" id="swatches" aria-labelledby="tabber-swatches-label">
        <PaletteSwatches client:load />
      </article>
      <article
        class="tabber__panel"
        role="tabpanel"
        tabindex="0"
        id="ingredients"
        aria-labelledby="tabber-ingredients-label">
        <PaletteIngredients client:load />
      </article>
    </section>
  </div>
</Default>

<style>
  .tabber__header {
    margin-bottom: 2rem;
  }

  .tabber__tabs {
    display: flex;
    gap: 0.5rem;
    background-color: var(--mantle);
    padding: 0.5rem;
    border-radius: 10px;
    width: fit-content;
    position: relative;
  }
  .tabber__pills-background {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    height: calc(100% - 1rem);
    background-color: var(--mauve);
    border-radius: 5px;
    transition: all 200ms ease;
    pointer-events: none;
    z-index: 0;
  }

  .tabber__tab {
    position: relative;
    z-index: 1;
    padding: 0.625rem 1.5rem;
    color: var(--text);
    background-color: transparent;
    border: none;
    cursor: pointer;
    border-radius: 5px;
    transition: color 200ms ease;
    font: inherit;

    &:hover {
      background-color: var(--surface0);
      color: var(--mauve);
    }

    &[aria-selected="true"] {
      color: var(--base) !important;

      &:hover {
        background-color: rgba(0, 0, 0, 0.15);
      }
    }

    &:focus,
    &:focus-visible {
      background-color: var(--mauve);
      color: var(--base);
      outline: none;
    }
  }

  .tabber__section {
    display: grid;
    overflow: hidden;
    height: auto;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    scroll-snap-type: x mandatory;
    transition: height 200ms ease;
  }

  .tabber__panel {
    height: auto;
    scroll-snap-align: start;
    transition: height 200ms ease;
  }
</style>
